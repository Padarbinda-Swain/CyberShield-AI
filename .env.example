# Copy to .env and edit.  NEVER commit .env
JWT_SECRET=change-me-to-a-long-random-string
JWT_TTL_MINUTES=120
ADMIN_EMAIL=admin@cybershield.local
ADMIN_PASSWORD=ChangeMe!2024

# Cloud database (MongoDB Atlas). Leave empty to use the local JSON file store.
MONGODB_URI=
MONGODB_DB=cybershield

# Threat-intelligence keys (all optional - missing keys are skipped gracefully)
VIRUSTOTAL_API_KEY=
URLHAUS_AUTH_KEY=
GOOGLE_SAFE_BROWSING_KEY=

# Live DNS / TLS / RDAP / redirect checks (SSRF-guarded). Set false for fully offline analysis.
LIVE_NETWORK_CHECKS=true
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
LOG_LEVEL=INFO
